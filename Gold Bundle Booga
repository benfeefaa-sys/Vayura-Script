-- SPEED SLIDER
local Sliding = false

local function UpdateSlider()
    local range = Config.MaxSpeed - Config.MinSpeed
    local alpha = 0

    if range > 0 then
        alpha = (Speed - Config.MinSpeed) / range
    end

    alpha = math.clamp(alpha, 0, 1)

    Fill.Size = UDim2.fromScale(alpha, 1)
    Knob.Position = UDim2.fromScale(alpha, 0.5)
    SpeedLabel.Text = string.format("%.3fs", Speed)
end

local function SetSpeedAt(x)
    local width = math.max(Track.AbsoluteSize.X, 1)

    local alpha = math.clamp(
        (x - Track.AbsolutePosition.X) / width,
        0,
        1
    )

    local value = Config.MinSpeed +
        alpha * (Config.MaxSpeed - Config.MinSpeed)

    Speed = math.clamp(
        math.floor(value * 1000 + 0.5) / 1000,
        Config.MinSpeed,
        Config.MaxSpeed
    )

    UpdateSlider()
end

Connect(Track.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Sliding = true
        SetSpeedAt(input.Position.X)
    end
end)

-- DRAGGING
local Dragging = false
local DragStart
local InitialPosition

Connect(Header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        InitialPosition = Main.Position
    end
end)

Connect(UIS.InputChanged, function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if Sliding then
        SetSpeedAt(input.Position.X)
    end

    if Dragging and DragStart and InitialPosition then
        local delta = input.Position - DragStart

        Main.Position = UDim2.new(
            InitialPosition.X.Scale,
            InitialPosition.X.Offset + delta.X,
            InitialPosition.Y.Scale,
            InitialPosition.Y.Offset + delta.Y
        )
    end
end)

Connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Sliding = false
        Dragging = false
    end
end)

-- AUTO BUY ENGINE
local function RefreshButton()
    if Enabled then
        Status.Text = "RUNNING"
        Status.TextColor3 = Theme.Accent

        Toggle.Text = "STOP AUTO BUY"
        Toggle.BackgroundColor3 = Theme.Red
        Toggle.TextColor3 = Theme.Text
    else
        Status.Text = "IDLE"
        Status.TextColor3 = Theme.Muted

        Toggle.Text = "START AUTO BUY"
        Toggle.BackgroundColor3 = Theme.Accent
        Toggle.TextColor3 = Theme.BG
    end
end

local function SetEnabled(value)
    if Enabled == value then
        return
    end

    Enabled = value
    RunID += 1

    RefreshButton()

    if not Enabled then
        return
    end

    local CurrentRun = RunID

    task.spawn(function()
        while Enabled
            and CurrentRun == RunID
            and Gui.Parent do

            -- Enforce an effective minimum interval.
            local interval = math.max(
                Speed,
                1 / math.max(Config.MaxRequestsPerSecond, 1)
            )

            task.wait(interval)

            if not Enabled
                or CurrentRun ~= RunID
                or not Gui.Parent then
                break
            end

            if not Remote.Parent then
                warn("[VAYURA] Remote disconnected.")
                SetEnabled(false)
                break
            end

            local success, err = pcall(function()
                Remote:FireServer(Payload)
            end)

            if success then
                Requests += 1
            else
                warn("[VAYURA] Request failed:", err)
                SetEnabled(false)
                break
            end
        end
    end)
end

Connect(Toggle.MouseButton1Click, function()
    SetEnabled(not Enabled)
end)

Connect(UIS.InputBegan, function(input, processed)
    if processed or not Gui.Parent then
        return
    end

    if input.KeyCode == Config.ToggleKey then
        SetEnabled(not Enabled)
    end
end)

Connect(Close.MouseButton1Click, function()
    SetEnabled(false)
    Gui:Destroy()
end)

Connect(Gui.Destroying, function()
    Enabled = false
    RunID += 1

    for _, connection in ipairs(Connections) do
        connection:Disconnect()
    end

    table.clear(Connections)
end)

-- LIVE STATISTICS
task.spawn(function()
    local PreviousCount = 0

    while Gui.Parent do
        task.wait(1)

        if not Gui.Parent then
            break
        end

        local Difference = Requests - PreviousCount
        PreviousCount = Requests

        Rate = Difference

        CountText.Text = tostring(Requests)
        RateText.Text = tostring(Rate) .. " / SEC"
    end
end)

