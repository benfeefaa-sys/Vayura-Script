-- SPEED CONTROL

local function updateSpeed()
    local alpha =
        (MAX_DELAY - delayTime) /
        (MAX_DELAY - MIN_DELAY)

    fill.Size = UDim2.fromScale(alpha, 1)
    knob.Position = UDim2.fromScale(alpha, 0.5)

    speedText.Text = string.format(
        "%.2fs  /  %.1f per sec",
        delayTime,
        1 / delayTime
    )
end

local function setSpeedFromX(x)
    local alpha = math.clamp(
        (x - slider.AbsolutePosition.X) /
        slider.AbsoluteSize.X,
        0,
        1
    )

    delayTime = MAX_DELAY -
        alpha * (MAX_DELAY - MIN_DELAY)

    delayTime = math.floor(delayTime * 100 + 0.5) / 100

    updateSpeed()
end

local sliding = false

local function beginSlide(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliding = true
        setSpeedFromX(input.Position.X)
    end
end

slider.InputBegan:Connect(beginSlide)
knob.InputBegan:Connect(beginSlide)

UIS.InputChanged:Connect(function(input)
    if not sliding then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        setSpeedFromX(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliding = false
    end
end)


local function refreshToggle()
    if enabled then
        toggle.BackgroundColor3 = Color3.fromRGB(28, 43, 41)
        indicator.BackgroundColor3 = C.green
        toggleText.Text = "STOP AUTOBUY"
        status.Text = "RUNNING"
        status.TextColor3 = C.green
    else
        toggle.BackgroundColor3 = C.surface
        indicator.BackgroundColor3 = C.muted
        toggleText.Text = "START AUTOBUY"
        status.Text = "OFFLINE"
        status.TextColor3 = C.muted
    end
end

toggle.MouseButton1Click:Connect(function()
    enabled = not enabled
    refreshToggle()
end)

close.MouseButton1Click:Connect(function()
    enabled = false
    gui:Destroy()
end)

local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging or not dragStart then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

task.spawn(function()
    while gui.Parent do
        if enabled then
            remote:FireServer(payload)

            attempts += 1
            attemptsText.Text =
                "REQUESTS SENT   " .. tostring(attempts)

            task.wait(delayTime)
        else
            task.wait(0.08)
        end
    end
end)

